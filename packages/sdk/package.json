{
  "name": "@settlekit/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the SettleKit API: USDC checkout, invoices, webhooks, access checks.",
  "license": "MIT",
  "keywords": [
    "settlekit",
    "usdc",
    "stablecoin",
    "payments",
    "checkout",
    "x402",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/caelum0x/settlekit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://settlekit.dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@settlekit/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
