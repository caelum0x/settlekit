{
  "name": "@settlekit/routing",
  "version": "0.0.0",
  "type": "module",
  "description": "Any-token checkout routing: Relay (primary) and LI.FI (fallback) quotes and status behind one RouteProvider interface, plus fee/slippage/origin policy and per-network destinations.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@settlekit/chains": "workspace:*",
    "@settlekit/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
